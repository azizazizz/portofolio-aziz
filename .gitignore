# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files (never commit secrets)
.env
.env.*
!.env.example

# Raw/unoptimized screenshots and photos (only the cropped+compressed copies are used)
src/assets/projects/**/Screenshot*.png
src/assets/projects/**/WhatsApp Image*.jpeg

# Certificate PDFs (~12MB). The compressed .jpg previews ARE committed, so the
# gallery still works; only the "Open PDF" link is absent on a fresh clone.
# The CV pdf is intentionally NOT ignored — the About button depends on it.
src/assets/certificates/*.pdf

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
